  m_Name: Quest_WhatTheLedgerSays
  m_EditorClassIdentifier: Game.Data::EndlessDescent.Data.AuthoredQuestDefinition
  id: quest.act1.ledger
  title: What the Ledger Says
  giver: {fileID: 11400000, guid: 3d0eaa6ab437133d89473d2dba27f1a9, type: 2}
  faction: {fileID: 11400000, guid: fba0a8fe9beb89c1f88b8c0dd2a76d54, type: 2}
  reason: The burial register for the undercroft is eleven years out of date, and
    the Gravewardens will not release a body without one.
  complication: Bringing the register up to date means naming who is down there,
    and one of the names is going to be his brother's.
  availability: []
  stages:
  - Title: Ask the warden
    Summary: Only the Gravewardens know what the register is supposed to say.
    Objectives:
    - Kind: 3
      Description: Speak to Perrin Ossel
      Item: {fileID: 0}
      Npc: {fileID: 11400000, guid: 9ec4428bbdff2bfa3a15ad688555f7aa, type: 2}
      Location: {fileID: 0}
      Enemy: {fileID: 0}
      Count: 1
    OnEnter: []
  - Title: Bring back what is left
    Summary: Four names, and something of each of them to prove it.
    Objectives:
    - Kind: 1
      Description: Collect 4 Bone Dust
      Item: {fileID: 11400000, guid: 7dbbc0410a576b2c393cc562dd0a7181, type: 2}
      Npc: {fileID: 0}
      Location: {fileID: 0}
      Enemy: {fileID: 0}
      Count: 4
    OnEnter: []
  - Title: Hand it over
    Summary: He will not read it in front of you.
    Objectives:
    - Kind: 2
      Description: Take 4 Bone Dust to Rowen Stagg
      Item: {fileID: 11400000, guid: 7dbbc0410a576b2c393cc562dd0a7181, type: 2}
      Npc: {fileID: 11400000, guid: 3d0eaa6ab437133d89473d2dba27f1a9, type: 2}
      Location: {fileID: 0}
      Enemy: {fileID: 0}
      Count: 4
    OnEnter: []
